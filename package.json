{
  "name": "RENAME_ME",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/charlie-labs/bun-lib-template.git"
  },
  "homepage": "https://github.com/charlie-labs/bun-lib-template",
  "bugs": {
    "url": "https://github.com/charlie-labs/bun-lib-template/issues"
  },
  "zshy": "./src/index.ts",
  "scripts": {
    "build": "bun run --bun zshy",
    "ci": "bun run typecheck && bun run lint && bun run test",
    "clean": "rm -rf node_modules",
    "fix": "eslint --fix --quiet . ; prettier --write --log-level=silent .",
    "lint": "eslint . && prettier --check .",
    "prepare": "husky",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prettier": "@charlie-labs/config/prettier",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@charlie-labs/config": "^0.0.16",
    "@types/bun": "^1.3.1",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "knip": "^5.67.1",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "zshy": "^0.4.4"
  },
  "packageManager": "bun@1.2.22",
  "engines": {
    "bun": "1"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
